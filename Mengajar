async function addGuru(){
  const input = document.getElementById('newGuru');
  const mapelInput = document.getElementById('newGuruMapel');
  const nipInput = document.getElementById('newGuruNip');
  const val = input.value.trim();
  const mapel = mapelInput.value.trim();
  const nip = nipInput.value.trim();
  if(!val){ showToast('Isi nama guru terlebih dahulu.'); return; }
  if(guruList.some(g=>g.nama===val)){ showToast('Nama guru sudah ada.'); return; }
  if(!requireSupabase()) return;
  const { data, error } = await sb.from('guru').insert({ nama: val, mapel, nip }).select().single();
  if(error){ console.error(error); showToast('Gagal menambah guru.'); return; }
  guruList.push({ id: data.id, nama: data.nama, mapel: data.mapel || '', nip: data.nip || '' });
  input.value = ''; mapelInput.value = ''; nipInput.value = '';
  renderGuruSettingsList();
  renderGuruOptions();
  onGuruChange();
  showToast('Guru ditambahkan.');
}
async function removeGuru(id){
