}
function renderJamSettingsList(){
  const ul = document.getElementById('jamListUI');
  ul.innerHTML = jamList.length
    ? jamList.map(j=>`<li><span>${escapeHtml(jamDisplay(j))}</span><button onclick="removeJam('${j.id}')">Hapus</button></li>`).join('')
    : '<div class="empty-row">Belum ada jam mengajar ditambahkan.</div>';
