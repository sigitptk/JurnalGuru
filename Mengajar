// ---- Gambar Kop (Supabase Storage) ----
function renderHeaderImagePreview(){
  const wrap = document.getElementById('headerImagePreviewWrap');
  const img = document.getElementById('headerImagePreview');
  if(headerImage && headerImage.url){
    img.src = headerImage.url;
    wrap.style.display = 'block';
  }else{
    wrap.style.display = 'none';
  }
}
async function handleHeaderImageUpload(event){
  const file = event.target.files[0];
  if(!file) return;
  if(!['image/png','image/jpeg'].includes(file.type)){
    showToast('Format gambar harus PNG atau JPG.');
    event.target.value = '';
    return;
  }
  if(file.size > 800*1024){
    showToast('Ukuran file terlalu besar. Gunakan gambar di bawah 500KB.');
    event.target.value = '';
    return;
  }
  if(!requireSupabase()){ event.target.value = ''; return; }

  showToast('Mengupload gambar...');
  const ext = file.type === 'image/png' ? 'png' : 'jpg';
  const path = `kop-${Date.now()}.${ext}`;
  const { error: upErr } = await sb.storage.from(HEADER_BUCKET).upload(path, file, { upsert: true, contentType: file.type });
  if(upErr){
    console.error(upErr);
    showToast('Gagal mengupload gambar. Pastikan bucket "header-images" sudah dibuat & public.');
    event.target.value = '';
    return;
  }
  const { data: urlData } = sb.storage.from(HEADER_BUCKET).getPublicUrl(path);
  const publicUrl = urlData.publicUrl;

  const { error: updErr } = await sb.from('pengaturan').update({ header_image_url: publicUrl }).eq('id', 1);
  if(updErr){
    console.error(updErr);
    showToast('Gagal menyimpan URL gambar.');
    event.target.value = '';
    return;
  }

  headerImage = { url: publicUrl };
  renderHeaderImagePreview();
  showToast('Gambar kop berhasil disimpan.');
  event.target.value = '';
}
async function removeHeaderImage(){
  if(!confirm('Hapus gambar kop dan kembali memakai kop teks otomatis?')) return;
  if(!requireSupabase()) return;
  const { error } = await sb.from('pengaturan').update({ header_image_url: null }).eq('id', 1);
  if(error){ console.error(error); showToast('Gagal menghapus gambar kop.'); return; }
  headerImage = null;
  renderHeaderImagePreview();
  showToast('Gambar kop dihapus.');
}

// ---- Kehadiran ----
function toggleHadirSemua(){
  const checked = document.getElementById('fHadirSemua').checked;
  document.getElementById('absenDetail').style.display = checked ? 'none' : 'block';
  if(checked){
    absenSiswaList = [];
    renderSiswaList();
  }
}
function addSiswa(status){
  const input = document.getElementById('fSiswaNama');
  const nama = input.value.trim();
  if(!nama){ showToast('Isi nama siswa terlebih dahulu.'); return; }
  absenSiswaList.push({nama, status});
  input.value = '';
  input.focus();
  renderSiswaList();
}
function removeSiswa(i){
  absenSiswaList.splice(i,1);
  renderSiswaList();
}
function renderSiswaList(){
  const ul = document.getElementById('siswaListUI');
  if(!ul) return;
  ul.innerHTML = absenSiswaList.length
    ? absenSiswaList.map((s,i)=>`<li><span>${escapeHtml(s.nama)} — ${escapeHtml(s.status)}</span><button onclick="removeSiswa(${i})">Hapus</button></li>`).join('')
    : '<div class="empty-row">Belum ada siswa ditambahkan.</div>';
}
function absenText(e){
  if(!e.absen || e.absen.hadirSemua) return 'Hadir Semua';
  const list = e.absen.list || [];
  const sakit = list.filter(s=>s.status==='Sakit').map(s=>s.nama);
  const ijin = list.filter(s=>s.status==='Ijin').map(s=>s.nama);
  const alpa = list.filter(s=>s.status==='Alpa').map(s=>s.nama);
  const parts = [];
  if(sakit.length) parts.push(`Sakit: ${sakit.join(', ')}`);
  if(ijin.length) parts.push(`Ijin: ${ijin.join(', ')}`);
  if(alpa.length) parts.push(`Alpa: ${alpa.join(', ')}`);
  return parts.length ? parts.join(' | ') : 'Hadir Semua';
}

// ---- Guru, Kelas, Jam (master data) ----
function renderGuruOptions(){
  const options = guruList.length
    ? guruList.map(g=>`<option value="${escapeHtml(g.nama)}">${escapeHtml(g.nama)}</option>`).join('')
    : '<option value="">— Belum ada data —</option>';
  const names = guruList.map(g=>g.nama);

  const sel = document.getElementById('fGuru');
  const current = sel.value;
  sel.innerHTML = options;
  document.getElementById('guruEmptyHint').style.display = guruList.length ? 'none' : 'block';
  if(names.includes(current)) sel.value = current;

  const pdfSel = document.getElementById('pdfGuru');
  if(pdfSel){
    const pdfCurrent = pdfSel.value;
    pdfSel.innerHTML = options;
    if(names.includes(pdfCurrent)) pdfSel.value = pdfCurrent;
  }
}
function renderKelasOptions(){
  const sel = document.getElementById('fKelas');
  const current = sel.value;
  sel.innerHTML = kelasList.length
    ? kelasList.map(k=>`<option value="${escapeHtml(k.nama)}">${escapeHtml(k.nama)}</option>`).join('')
    : '<option value="">— Belum ada data —</option>';
  document.getElementById('kelasEmptyHint').style.display = kelasList.length ? 'none' : 'block';
  if(kelasList.some(k=>k.nama===current)) sel.value = current;
