<script>
/* =====================================================================
   KONFIGURASI SUPABASE — WAJIB DIISI SEBELUM DIPAKAI
   1. Buka project Supabase Anda → Settings → API
   2. Salin "Project URL" ke SUPABASE_URL
   3. Salin "anon public" key ke SUPABASE_ANON_KEY
   ===================================================================== */
const SUPABASE_URL = "https://jiiddthqdkyphqwdrqfi.supabase.co"; // GANTI dengan Project URL Anda
const SUPABASE_ANON_KEY = "sb_publishable_GhV_8HKfFQ7kpW5_LYCWLg_lTv0wCkE"; // GANTI dengan anon public key Anda
const HEADER_BUCKET = 'header-images';

let sb = null;
let supabaseReady = false;
(function initSupabase(){
  const urlOk = SUPABASE_URL.startsWith('https://') && !SUPABASE_URL.includes('xxxx');
  const keyOk = SUPABASE_ANON_KEY && !SUPABASE_ANON_KEY.includes('xxxx');
  if(urlOk && keyOk && window.supabase){
    sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    supabaseReady = true;
  }
})();
function requireSupabase(){
  if(!supabaseReady){
    showToast('Supabase belum dikonfigurasi. Edit SUPABASE_URL & SUPABASE_ANON_KEY di kode.');
    return false;
  }
  return true;
}
function showConfigWarning(){
  const el = document.getElementById('configWarning');
  if(el) el.style.display = 'block';
}

let entries = [];
let guruList = [];
let kelasList = [];
let jamList = [];
let absenSiswaList = [];
let wilayah = '';
let kepsek = { nama: '', nip: '' };
let adminPin = '123456';
let headerImage = null;
let editingId = null;
let session = null; // { type: 'guru', nip, nama, mapel } atau { type: 'admin' }

// ---- Sesi Login ----
function loadSession(){
  try{
    const raw = localStorage.getItem('jm-session');
    session = raw ? JSON.parse(raw) : null;
  }catch(e){ session = null; }
}
function saveSession(){
  try{ localStorage.setItem('jm-session', JSON.stringify(session)); }
  catch(e){ /* abaikan */ }
}
function logout(){
  session = null;
  try{ localStorage.removeItem('jm-session'); }catch(e){}
  document.getElementById('loginNip').value = '';
  document.getElementById('loginAdminPin').value = '';
  showLoginBox();
  hideAdminBox();
  renderScreens();
}

function showRegisterBox(){
  document.getElementById('loginGuruBox').style.display = 'none';
  document.getElementById('registerGuruBox').style.display = 'block';
}
function showLoginBox(){
  document.getElementById('loginGuruBox').style.display = 'block';
  document.getElementById('registerGuruBox').style.display = 'none';
}
function showAdminBox(){
  document.getElementById('loginAdminBox').style.display = 'block';
  document.getElementById('adminToggleBtn').style.display = 'none';
}
function hideAdminBox(){
  document.getElementById('loginAdminBox').style.display = 'none';
  document.getElementById('adminToggleBtn').style.display = 'inline';
}

async function loginAsGuru(){
  const nip = document.getElementById('loginNip').value.trim();
  if(!nip){ showToast('Masukkan NIP terlebih dahulu.'); return; }
  if(!requireSupabase()) return;
  const { data, error } = await sb.from('guru').select('*').eq('nip', nip).maybeSingle();
  if(error){ console.error(error); showToast('Gagal memeriksa NIP.'); return; }
  if(!data){
    showToast('NIP tidak ditemukan. Silakan daftar sebagai guru baru.');
    return;
  }
  session = { type:'guru', id: data.id, nip: data.nip, nama: data.nama, mapel: data.mapel || '' };
  saveSession();
  await loadAll();
}

async function registerGuru(){
  const nama = document.getElementById('regNama').value.trim();
  const mapel = document.getElementById('regMapel').value.trim();
  const nip = document.getElementById('regNip').value.trim();
  if(!nama || !nip){ showToast('Nama dan NIP wajib diisi.'); return; }
  if(!requireSupabase()) return;

  const { data: existing } = await sb.from('guru').select('id').eq('nip', nip).maybeSingle();
  if(existing){ showToast('NIP ini sudah terdaftar. Silakan masuk lewat menu Masuk.'); return; }

  const { data, error } = await sb.from('guru').insert({ nama, mapel, nip }).select().single();
  if(error){ console.error(error); showToast('Gagal mendaftar. Coba lagi.'); return; }

  session = { type:'guru', id: data.id, nip: data.nip, nama: data.nama, mapel: data.mapel || '' };
  saveSession();
  showToast('Pendaftaran berhasil!');
  await loadAll();
}

async function loginAsAdmin(){
  const pin = document.getElementById('loginAdminPin').value.trim();
  if(!pin){ showToast('Masukkan PIN Admin.'); return; }
  if(!requireSupabase()) return;
  const { data, error } = await sb.from('pengaturan').select('admin_pin').eq('id', 1).maybeSingle();
  if(error){ console.error(error); showToast('Gagal memeriksa PIN.'); return; }
  const correctPin = (data && data.admin_pin) ? data.admin_pin : '123456';
  if(pin !== correctPin){
    showToast('PIN Admin salah.');
    return;
  }
  session = { type:'admin' };
  saveSession();
  await loadAll();
}

function renderScreens(){
  const isLoggedIn = !!session;
  document.getElementById('loginScreen').style.display = isLoggedIn ? 'none' : 'block';
  document.getElementById('appScreen').style.display = isLoggedIn ? 'block' : 'none';
  if(!isLoggedIn) return;

  const isAdmin = session.type === 'admin';
  document.getElementById('tabSettings').style.display = isAdmin ? 'block' : 'none';
  document.getElementById('sessionLabel').textContent = isAdmin
    ? 'Masuk sebagai Admin'
    : `Masuk sebagai ${session.nama}`;

  if(!isAdmin){
    // Guru: kunci Nama Guru di form Tulis ke identitas sendiri
    const guruField = document.getElementById('fGuru');
    if(guruField){
      guruField.value = session.nama;
      guruField.disabled = true;
    }
    const pdfGuruField = document.getElementById('pdfGuru');
    if(pdfGuruField){
      pdfGuruField.value = session.nama;
      pdfGuruField.disabled = true;
    }
    onGuruChange();
  }else{
    const guruField = document.getElementById('fGuru');
    if(guruField) guruField.disabled = false;
    const pdfGuruField = document.getElementById('pdfGuru');
    if(pdfGuruField) pdfGuruField.disabled = false;
  }
}

async function loadAll(){
  loadSession();
  renderScreens();
  if(!session){
    return;
  }

  if(!supabaseReady){
    showConfigWarning();
    renderGuruOptions(); renderKelasOptions(); renderJamOptions();
    renderGuruSettingsList(); renderKelasSettingsList(); renderJamSettingsList();
    renderHeaderImagePreview();
    renderEntries(); updateStats(); onGuruChange();
    return;
  }
  try{
    const [guruRes, kelasRes, jamRes, entryRes, pengRes] = await Promise.all([
      sb.from('guru').select('*').order('nama'),
      sb.from('kelas').select('*').order('nama'),
      sb.from('jam_mengajar').select('*').order('created_at'),
      sb.from('jurnal_entries').select('*').order('created_at'),
      sb.from('pengaturan').select('*').eq('id', 1).maybeSingle()
    ]);

    guruList = (guruRes.data || []).map(g => ({ id: g.id, nama: g.nama, mapel: g.mapel || '', nip: g.nip || '' }));
    kelasList = (kelasRes.data || []).map(k => ({ id: k.id, nama: k.nama }));
    jamList = (jamRes.data || []).map(j => ({ id: j.id, label: j.label, waktu: j.waktu || '' }));

    let allEntries = (entryRes.data || []).map(e => ({
      id: e.id,
      guru: e.guru,
      tanggal: e.tanggal,
      kelas: e.kelas,
      jam: e.jam,
      materi: e.materi,
      refleksi1: e.refleksi1 || '',
      refleksi2: e.refleksi2 || '',
      refleksi3: e.refleksi3 || '',
      absen: e.absen || { hadirSemua: true, list: [] },
      createdAt: e.created_at ? new Date(e.created_at).getTime() : Date.now()
    }));

    // Guru hanya melihat catatannya sendiri; Admin melihat semua
    entries = (session.type === 'admin') ? allEntries : allEntries.filter(e => e.guru === session.nama);

    if(pengRes.data){
      wilayah = pengRes.data.wilayah || '';
      kepsek = { nama: pengRes.data.kepsek_nama || '', nip: pengRes.data.kepsek_nip || '' };
      headerImage = pengRes.data.header_image_url ? { url: pengRes.data.header_image_url } : null;
      adminPin = pengRes.data.admin_pin || '123456';
    }
  }catch(err){
    console.error(err);
    showToast('Gagal memuat data dari Supabase. Cek koneksi/konfigurasi.');
  }

  document.getElementById('wilayahInput').value = wilayah;
  document.getElementById('kepsekNamaInput').value = kepsek.nama || '';
  document.getElementById('kepsekNipInput').value = kepsek.nip || '';
  const adminPinInputEl = document.getElementById('adminPinInput');
  if(adminPinInputEl) adminPinInputEl.value = '';
  renderHeaderImagePreview();

  renderGuruOptions();
  renderKelasOptions();
  renderJamOptions();
  renderGuruSettingsList();
  renderKelasSettingsList();
  renderJamSettingsList();
  renderEntries();
  updateStats();
  renderScreens();
}

function switchView(name){
  ['write','hist','settings'].forEach(v=>{
    document.getElementById('view'+capitalize(v)).classList.toggle('active', v===name);
    document.getElementById('tab'+capitalize(v)).classList.toggle('active', v===name);
  });
  if(name==='hist') renderEntries();
}
function capitalize(s){ return s.charAt(0).toUpperCase()+s.slice(1); }

