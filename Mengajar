  if(kelasList.some(k=>k.nama===val)){ showToast('Nama kelas sudah ada.'); return; }
  if(!requireSupabase()) return;
  const { data, error } = await sb.from('kelas').insert({ nama: val }).select().single();
  if(error){ console.error(error); showToast('Gagal menambah kelas.'); return; }
  kelasList.push({ id: data.id, nama: data.nama });
  input.value = '';
  renderKelasSettingsList();
  renderKelasOptions();
  showToast('Kelas ditambahkan.');
}
async function removeKelas(id){
  if(!confirm('Hapus nama kelas ini dari daftar?')) return;
  if(!requireSupabase()) return;
  const { error } = await sb.from('kelas').delete().eq('id', id);
  if(error){ console.error(error); showToast('Gagal menghapus kelas.'); return; }
  kelasList = kelasList.filter(k=>k.id!==id);
  renderKelasSettingsList();
  renderKelasOptions();
}
async function addJam(){
  const labelInput = document.getElementById('newJamLabel');
  const waktuInput = document.getElementById('newJamWaktu');
  const label = labelInput.value.trim();
  const waktu = waktuInput.value.trim();
  if(!label){ showToast('Isi kategori jam terlebih dahulu.'); return; }
  if(jamList.some(j=>j.label===label)){ showToast('Kategori jam sudah ada.'); return; }
  if(!requireSupabase()) return;
  const { data, error } = await sb.from('jam_mengajar').insert({ label, waktu }).select().single();
  if(error){ console.error(error); showToast('Gagal menambah jam mengajar.'); return; }
  jamList.push({ id: data.id, label: data.label, waktu: data.waktu || '' });
  labelInput.value = ''; waktuInput.value = '';
  renderJamSettingsList();
  renderJamOptions();
  showToast('Jam mengajar ditambahkan.');
}
async function removeJam(id){
  if(!confirm('Hapus data jam mengajar ini?')) return;
  if(!requireSupabase()) return;
  const { error } = await sb.from('jam_mengajar').delete().eq('id', id);
  if(error){ console.error(error); showToast('Gagal menghapus jam.'); return; }
  jamList = jamList.filter(j=>j.id!==id);
  renderJamSettingsList();
  renderJamOptions();
}

// ---- Entries (Jurnal) ----
async function saveEntry(){
  const guru = document.getElementById('fGuru').value;
  const tanggal = document.getElementById('fTanggal').value;
  const kelas = document.getElementById('fKelas').value;
  const jam = document.getElementById('fJam').value;
  const materi = document.getElementById('fMateri').value.trim();
  const refleksi1 = document.getElementById('fRefleksi1').value.trim();
  const refleksi2 = document.getElementById('fRefleksi2').value.trim();
  const refleksi3 = document.getElementById('fRefleksi3').value.trim();
  const hadirSemua = document.getElementById('fHadirSemua').checked;
  const absen = { hadirSemua, list: hadirSemua ? [] : absenSiswaList.slice() };

  if(!guru || !kelas){
    showToast('Pilih nama guru dan kelas terlebih dahulu (tambahkan di Pengaturan jika belum ada).');
    return;
  }
  if(!tanggal || !materi){
    showToast('Mohon isi tanggal dan materi.');
    return;
  }
  if(!requireSupabase()) return;

  const payload = { guru, tanggal, kelas, jam, materi, refleksi1, refleksi2, refleksi3, absen };

  if(editingId){
    const { error } = await sb.from('jurnal_entries').update(payload).eq('id', editingId);
    if(error){ console.error(error); showToast('Gagal memperbarui catatan.'); return; }
    const idx = entries.findIndex(e=>e.id===editingId);
    if(idx>-1) entries[idx] = {...entries[idx], ...payload};
    showToast('Catatan diperbarui.');
  }else{
    const { data, error } = await sb.from('jurnal_entries').insert(payload).select().single();
    if(error){ console.error(error); showToast('Gagal menyimpan catatan.'); return; }
    entries.push({ ...payload, id: data.id, createdAt: new Date(data.created_at).getTime() });
    showToast('Catatan tersimpan.');
  }

  resetForm();
  updateStats();
  switchView('hist');
}

function resetForm(){
  editingId = null;
  document.getElementById('fTanggal').value = todayStr();
  document.getElementById('fMateri').value = '';
  document.getElementById('fRefleksi1').value = '';
  document.getElementById('fRefleksi2').value = '';
  document.getElementById('fRefleksi3').value = '';
  document.getElementById('fHadirSemua').checked = true;
  absenSiswaList = [];
  toggleHadirSemua();
  document.getElementById('saveBtn').textContent = 'Simpan Catatan';
  document.getElementById('cancelEditBtn').style.display = 'none';
}

function editEntry(id){
  const e = entries.find(x=>x.id===id);
  if(!e) return;
  editingId = id;
  document.getElementById('fGuru').value = e.guru;
  document.getElementById('fTanggal').value = e.tanggal;
  document.getElementById('fKelas').value = e.kelas;
  document.getElementById('fJam').value = e.jam || '';
  document.getElementById('fMateri').value = e.materi;
  document.getElementById('fRefleksi1').value = e.refleksi1 || '';
  document.getElementById('fRefleksi2').value = e.refleksi2 || '';
  document.getElementById('fRefleksi3').value = e.refleksi3 || '';
  const absen = e.absen || {hadirSemua:true, list:[]};
  document.getElementById('fHadirSemua').checked = absen.hadirSemua;
  absenSiswaList = (absen.list || []).slice();
  toggleHadirSemua();
  renderSiswaList();
  document.getElementById('saveBtn').textContent = 'Perbarui Catatan';
  document.getElementById('cancelEditBtn').style.display = 'block';
  onGuruChange();
  switchView('write');
}

async function deleteEntry(id){
  if(!confirm('Hapus catatan ini?')) return;
  if(!requireSupabase()) return;
  const { error } = await sb.from('jurnal_entries').delete().eq('id', id);
  if(error){ console.error(error); showToast('Gagal menghapus catatan.'); return; }
  entries = entries.filter(e=>e.id!==id);
  renderEntries();
  updateStats();
  showToast('Catatan dihapus.');
}

function formatDate(d){
  const date = new Date(d + 'T00:00:00');
  return date.toLocaleDateString('id-ID', {day:'numeric', month:'short', year:'numeric'});
}

function updateStats(){
  document.getElementById('statTotal').textContent = entries.length;
  const now = new Date();
  const weekAgo = new Date(now.getTime() - 7*24*60*60*1000);
  const weekCount = entries.filter(e => new Date(e.tanggal+'T00:00:00') >= weekAgo).length;
  document.getElementById('statWeek').textContent = weekCount;
}

function renderEntries(){
  const list = document.getElementById('entryList');
  const q = (document.getElementById('searchBox')?.value || '').toLowerCase();
  let filtered = entries.filter(e =>
    (e.guru||'').toLowerCase().includes(q) ||
    (e.kelas||'').toLowerCase().includes(q) ||
    (e.materi||'').toLowerCase().includes(q)
  );
  filtered.sort((a,b)=> b.tanggal.localeCompare(a.tanggal) || b.createdAt-a.createdAt);

  if(filtered.length===0){
    list.innerHTML = '<div class="empty"><span class="mark">Belum ada catatan</span>Mulai tulis jurnal mengajar pertamamu di tab Tulis.</div>';
    return;
  }

  list.innerHTML = filtered.map(e => `
    <div class="entry">
      <div class="top">
        <div>
          <h3>${escapeHtml(e.materi)}</h3>
          <div class="sub">${escapeHtml(e.guru)} · ${escapeHtml(e.kelas)} · Jam ke ${escapeHtml(e.jam||'-')}</div>
        </div>
        <span class="date">${formatDate(e.tanggal)}</span>
      </div>
      ${e.refleksi1 ? `<div class="kv"><div class="k">1. Pengalaman/Hal Baik</div><div class="v">${escapeHtml(e.refleksi1)}</div></div>` : ''}
      ${e.refleksi2 ? `<div class="kv"><div class="k">2. Hal Belum Baik/Kendala</div><div class="v">${escapeHtml(e.refleksi2)}</div></div>` : ''}
      ${e.refleksi3 ? `<div class="kv"><div class="k">3. Tindak Lanjut</div><div class="v">${escapeHtml(e.refleksi3)}</div></div>` : ''}
      <div class="kv"><div class="k">Kehadiran Siswa</div><div class="v">${escapeHtml(absenText(e))}</div></div>
      <div class="actions">
        <button class="edit" onclick="editEntry('${e.id}')">Ubah</button>
        ${session && session.type === 'admin' ? `<button class="del" onclick="deleteEntry('${e.id}')">Hapus</button>` : ''}
      </div>
    </div>
  `).join('');
}

function escapeHtml(str){
  const div = document.createElement('div');
  div.textContent = str || '';
  return div.innerHTML;
}

function exportCSV(){
  if(entries.length===0){
    showToast('Belum ada data untuk diunduh.');
    return;
  }
  const header = ['Tanggal','Guru','Kelas','Jam Ke','Materi','1. Pengalaman/Hal Baik','2. Hal Belum Baik/Kendala','3. Tindak Lanjut','Kehadiran Siswa'];
  const rows = entries.slice().sort((a,b)=>a.tanggal.localeCompare(b.tanggal)).map(e =>
    [e.tanggal, e.guru, e.kelas, e.jam, e.materi, e.refleksi1, e.refleksi2, e.refleksi3, absenText(e)]
      .map(v => `"${String(v||'').replace(/\n/g,' ').replace(/"/g,'""')}"`).join(',')
  );
  const csv = [header.join(','), ...rows].join('\n');
  const blob = new Blob(["\uFEFF"+csv], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'jurnal-mengajar.csv';
  a.click();
  URL.revokeObjectURL(url);
}

function loadImageAsDataUrl(url){
  return fetch(url)
    .then(res => res.blob())
    .then(blob => new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result);
      reader.onerror = reject;
      reader.readAsDataURL(blob);
    }));
}

async function generateJournalPDF(){
  const guruName = document.getElementById('pdfGuru').value;
  const tanggal = document.getElementById('pdfTanggal').value;

  if(!guruName){
    showToast('Pilih nama guru terlebih dahulu.');
    return;
  }
  if(!tanggal){
    showToast('Pilih tanggal jurnal terlebih dahulu.');
    return;
  }

  const matched = entries
    .filter(e => e.guru === guruName && e.tanggal === tanggal)
    .sort((a,b)=> a.createdAt - b.createdAt);

  if(matched.length === 0){
    showToast('Tidak ada catatan untuk guru dan tanggal tersebut.');
    return;
  }

  const guruData = guruList.find(g => g.nama === guruName) || {nama: guruName, mapel: '', nip: ''};

  let headerImgData = null;
  if(headerImage && headerImage.url){
    try{
      const dataUrl = await loadImageAsDataUrl(headerImage.url);
      const dims = await new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => resolve({width: img.naturalWidth, height: img.naturalHeight});
        img.onerror = reject;
        img.src = dataUrl;
      });
      headerImgData = { dataUrl, width: dims.width, height: dims.height };
    }catch(err){
      console.error(err);
    }
  }

  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({unit:'mm', format:'a4', orientation:'portrait'});
  const pageWidth = doc.internal.pageSize.getWidth();
  const pageHeight = doc.internal.pageSize.getHeight();
  const marginLeft = 16;
  const marginRight = 16;
  const usableWidth = pageWidth - marginLeft - marginRight;
  const marginBottom = 20;
  let y = 6;

  function ensureSpace(needed){
    if(y + needed > pageHeight - marginBottom){
      doc.addPage();
      y = 20;
    }
  }

  // Kop Surat
  if(headerImgData){
    const maxW = usableWidth;
    const maxH = 22;
    let imgW = maxW;
    let imgH = imgW * (headerImgData.height / headerImgData.width);
    if(imgH > maxH){
      imgH = maxH;
      imgW = imgH * (headerImgData.width / headerImgData.height);
    }
    const imgX = (pageWidth - imgW) / 2;
    const format = headerImgData.dataUrl.startsWith('data:image/png') ? 'PNG' : 'JPEG';
    doc.addImage(headerImgData.dataUrl, format, imgX, y, imgW, imgH);
    y += imgH + 3;
    doc.setLineWidth(0.6);
    doc.line(marginLeft, y, pageWidth-marginRight, y);
    y += 6;
  }else{
    doc.setFont('helvetica','bold');
    doc.setFontSize(12);
    doc.text('PEMERINTAH PROVINSI BALI', pageWidth/2, y, {align:'center'});
    y += 5;
    doc.text('SMK NEGERI 4 NEGARA', pageWidth/2, y, {align:'center'});
    y += 3.5;
    doc.setLineWidth(0.6);
    doc.line(marginLeft, y, pageWidth-marginRight, y);
    y += 6;
  }

  // Judul
  doc.setFont('helvetica','bold');
  doc.setFontSize(12);
  doc.text('JURNAL DAN REFLEKSI PASCA PEMBELAJARAN GURU (SIPAJAR)', pageWidth/2, y, {align:'center'});
  y += 5.5;
  doc.text('TAHUN PELAJARAN 2026/2027', pageWidth/2, y, {align:'center'});
  y += 9;

  // A. Jurnal Guru
  doc.setFont('helvetica','bold');
  doc.setFontSize(12);
  doc.text('A. Jurnal Guru', marginLeft, y);
  y += 5;

  const head = [['No','Tanggal','Jam Ke','Kelas','Materi','Kehadiran']];
  const body = matched.map((e, i) => [
    String(i+1),
    formatDate(e.tanggal),
    e.jam || '-',
    e.kelas || '-',
    e.materi || '-',
    absenText(e)
  ]);

  doc.autoTable({
    head: head,
    body: body,
    startY: y,
    margin: { left: marginLeft, right: marginRight },
    theme: 'grid',
    styles: { font: 'helvetica', fontSize: 12, cellPadding: 1.8, valign: 'top', overflow: 'linebreak', lineWidth: 0.35, lineColor: [0,0,0] },
    headStyles: { fillColor: [63,98,89], textColor: 255, fontStyle: 'bold', fontSize: 12, halign: 'center', cellPadding: 2, lineWidth: 0.35, lineColor: [0,0,0] },
    bodyStyles: { fontSize: 12, lineWidth: 0.35, lineColor: [0,0,0] },
    columnStyles: {
      0: { cellWidth: 10, halign: 'center' },
      1: { cellWidth: 26 },
      2: { cellWidth: 18, halign: 'center' },
      3: { cellWidth: 18, halign: 'center' },
      4: { cellWidth: 'auto' },
      5: { cellWidth: 'auto' }
    }
  });

  y = doc.lastAutoTable.finalY + 10;

  // B. Refleksi Pasca Pembelajaran
  ensureSpace(20);
  doc.setFont('helvetica','bold');
  doc.setFontSize(12);
  doc.text('B. Refleksi Pasca Pembelajaran', marginLeft, y);
  y += 7;

  function addRefleksi(label, value){
    const indentX = marginLeft + 5;
    const boxWidth = pageWidth - marginRight - indentX;
    const tableLineWidth = 0.35;

    ensureSpace(12);
    doc.setFont('helvetica','bold');
    doc.setFontSize(12);
    const labelLines = doc.splitTextToSize(label, boxWidth);
    ensureSpace(labelLines.length * 5.5);
    doc.text(labelLines, indentX, y);
    y += labelLines.length * 5.5 + 0.5;

    doc.setFont('helvetica','normal');
    doc.setFontSize(12);
    const lines = doc.splitTextToSize(value && value.trim() ? value : '-', boxWidth - 6);
    const lineHeight = 5.5;
    const boxPadV = 3;
    const boxHeight = lines.length * lineHeight + boxPadV * 2;
    ensureSpace(boxHeight + 8);
    doc.setLineWidth(tableLineWidth);
    doc.rect(indentX, y, boxWidth, boxHeight, 'S');
    doc.text(lines, indentX + 3, y + boxPadV + 4);
    y += boxHeight + 8;
  }

  matched.forEach((e, idx) => {
    if(matched.length > 1){
      ensureSpace(8);
      doc.setFont('helvetica','bold');
      doc.setFontSize(12);
      doc.text(`Sesi ${idx+1} — Kelas ${e.kelas || '-'} (Jam ke ${e.jam || '-'})`, marginLeft, y);
      y += 6.5;
    }
    addRefleksi('1. Tuliskan pengalaman/hal-hal baik selama pembelajaran', e.refleksi1);
    addRefleksi('2. Tuliskan hal-hal yang belum baik/kendala dihadapi selama pembelajaran', e.refleksi2);
    addRefleksi('3. Tindak lanjut yang akan dilaksanakan untuk perbaikan pembelajaran', e.refleksi3);
  });

  // Tanda tangan — kiri (Kepala Sekolah) & kanan (Guru Mata Pelajaran)
  ensureSpace(52);
  y += 4;
  const signY0 = y;
  const rightX = pageWidth - marginRight;

  // Kiri — Mengetahui / Kepala Sekolah
  doc.setFont('helvetica','normal');
  doc.setFontSize(12);
  doc.text('Mengetahui,', marginLeft, signY0);
  doc.text('Kepala SMKN 4 Negara', marginLeft, signY0 + 5);
  doc.setFont('helvetica','bold');
  doc.text(kepsek.nama || '-', marginLeft, signY0 + 27);
  doc.setFont('helvetica','normal');
  doc.text(`NIP. ${kepsek.nip || '-'}`, marginLeft, signY0 + 32);

  // Kanan — Guru Mata Pelajaran (tetap)
  doc.setFont('helvetica','normal');
  doc.setFontSize(12);
  const wilayahTanggal = (wilayah ? wilayah + ', ' : '') + formatDate(tanggal);
  doc.text(wilayahTanggal, rightX, signY0, {align:'right'});
  doc.text(`Guru Mata Pelajaran ${guruData.mapel || ''}`.trim(), rightX, signY0 + 5, {align:'right'});
  doc.setFont('helvetica','bold');
  doc.text(guruData.nama, rightX, signY0 + 27, {align:'right'});
  doc.setFont('helvetica','normal');
  doc.text(`NIP. ${guruData.nip || '-'}`, rightX, signY0 + 32, {align:'right'});

  const safeName = guruName.replace(/[^a-z0-9]+/gi, '-').toLowerCase();
  doc.save(`jurnal-mengajar-${safeName}-${tanggal}.pdf`);
  showToast('PDF berhasil dibuat.');
}

let toastTimer;
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=> t.classList.remove('show'), 2400);
}

loadAll();
