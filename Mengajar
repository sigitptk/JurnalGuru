  const { error } = await sb.from('guru').delete().eq('id', id);
  if(error){ console.error(error); showToast('Gagal menghapus guru.'); return; }
  guruList = guruList.filter(g=>g.id!==id);
  renderGuruSettingsList();
  renderGuruOptions();
  onGuruChange();
}
