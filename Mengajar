  sel.innerHTML = jamList.length
    ? jamList.map(j=>`<option value="${escapeHtml(j.label)}">${escapeHtml(jamDisplay(j))}</option>`).join('')
    : '<option value="">— Belum ada data —</option>';
  document.getElementById('jamEmptyHint').style.display = jamList.length ? 'none' : 'block';
  if(jamList.some(j=>j.label===current)) sel.value = current;
}
